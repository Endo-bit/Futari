{
  "expo": {
    "name": "Futari",
    "slug": "FutariMobile",
    "scheme": "futari",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.futarimobile.app",
      "buildNumber": "45",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "es", "fr", "de", "it", "ja"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF4E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "@clerk/expo",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E6AEB9"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.futarimobile.app.FutariWidgets",
          "groupIdentifier": "group.com.futarimobile.app",
          "widgets": [
            {
              "name": "FutariWidget",
              "displayName": "Futari",
              "description": "Today's prompt, your couple question, or a countdown — you choose in the app.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48dc216a-b038-472f-aa9d-fb10d0fc9d87"
      }
    },
    "owner": "kosei.endo123"
  }
}
